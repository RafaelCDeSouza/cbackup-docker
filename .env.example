COMPOSE_PROJECT_NAME=cbackup

CBACKUP_HTTP_PORT=8080
CBACKUP_DAEMON_SSH_PORT=8437

MYSQL_DATABASE=cbackup
MYSQL_USER=cbackup
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

CBACKUP_SSH_ROOT_PASSWORD=change_me_ssh
CBACKUP_COOKIE_KEY=change_me_cookie_key

# Credenciais do scheduler SSH embutido no daemon (porta 8437)
# Devem bater com javaSchedulerUsername/javaSchedulerPassword no wizard
JAVA_SCHEDULER_USER=cbadmin
JAVA_SCHEDULER_PASS=change_me

# Token de API gerado pelo cBackup web (Settings > Worker > API token)
CBACKUP_TOKEN=change_me_token
CBACKUP_SCHEME=http
CBACKUP_SITE=cbackup-web

TZ=America/Sao_Paulo
